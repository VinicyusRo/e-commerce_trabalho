# Copie este arquivo para .env e preencha os valores.

# ---- Opção 1: banco online (Supabase) ----
# Endereço de conexão do Supabase. Se esta linha estiver preenchida,
# as variáveis DB_... abaixo são ignoradas.
DATABASE_URL=

# ---- Opção 2: banco local (pgAdmin) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_pc
DB_USER=postgres
DB_PASSWORD=

# ---- Login (JWT) ----
# Qualquer texto longo e secreto; usado para assinar os tokens
JWT_SECRET=
JWT_EXPIRA_EM=2h
